{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collegeum-telegram",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "BOT", "class_name": "TelegramBot"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["TelegramBot"]}],
  "vars": {"OWNER_IDS": "", "AI_ENABLED": "true", "PUBLIC_AI_ENABLED": "false",
    "PUBLIC_HOURLY_CAP": "100", "OPENROUTER_MODEL": "openrouter/free", "SITE_URL": "https://amirrezafarnamtaheri.github.io/Collegeum/"}
}
