# Copy to .env for local runs. In CI, configure repository secrets.
# Workflows inject them as environment variables.
# Do not commit real credential files (.env is gitignored).

# --- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Destination chat ID for new vacancy announcements.
# For personal bots, use your numerical chat ID (from `predoc-pipeline telegram-chat-id`).
# Channel broadcasts (@name or -100...) require setting TELEGRAM_ADMIN_CHAT_ID for bot commands.
TELEGRAM_PUBLIC_CHANNEL_ID=
# Optional: destination for administrative alerts (failing sources, empty runs).
# Defaults to TELEGRAM_PUBLIC_CHANNEL_ID when using private chats.
TELEGRAM_ADMIN_CHAT_ID=

# --- Model provider (OPTIONAL) ------------------------------------------------
# Leave empty to use the heuristic rule-based extractor.
# Runs locally without network API keys or request quotas.
# EXTRACTION_BACKEND=auto selects the first configured provider in order:
# GROQ -> NVIDIA -> OPENAI -> ANTHROPIC -> OPENROUTER -> MISTRAL -> GEMINI -> CUSTOM
# Falls back to the heuristic extractor when no provider keys exist.
EXTRACTION_BACKEND=auto

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenRouter (https://openrouter.ai/keys)
# Supports comma-separated keys for automatic key rotation on 429:
# OPENROUTER_API_KEY=sk-or-v1-key1,sk-or-v1-key2,...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Mistral AI (https://console.mistral.ai/)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Legacy memo alias: requires an explicit OpenAI-compatible chat URL and model.
# Mem0's memory API is not a chat-completions extraction endpoint.
MEMO_API_KEY=
MEMO_MODEL=
MEMO_BASE_URL=
# Custom / Local (Ollama, vLLM, LMStudio)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=default
CUSTOM_LLM_BASE_URL=http://localhost:8000/v1

# Concurrency & Rate Limits
EXTRACTION_CONCURRENCY=12
LLM_REQUESTS_PER_MINUTE=200
LLM_REQUESTS_PER_DAY=10000

# --- Source toggles ---------------------------------------------------
# Feeds and portals read what publishers deliberately syndicate. Read
# COMPLIANCE.md before enabling either flag below.
ENABLE_JOBSPY=false
ENABLE_TWITTER=false
# Only consulted if ENABLE_TWITTER=true. Format, one account per line:
#   username:password:email:email_password:cookies_json_string
# Injected as a single multi-line secret in CI; never write real values here.
TWSCRAPE_ACCOUNTS=

# --- X (Twitter) Integration ------------------------------------------
# Broadcasting: Automatically tweet new predoc listings to an X account.
# Requires a developer App at https://developer.x.com/en/portal/dashboard
# with User Authentication Settings configured as OAuth 1.0a (Read and Write).
X_BROADCAST_ENABLED=true
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Preserve the .ndjson sibling across runs for single-post and thread recovery.
X_THREAD_JOURNAL_PATH=data/x_threads.sqlite3
# Use a stable account ID before publishing to survive credential rotation.
X_PUBLICATION_SCOPE=
# Maximum existing website listings retried on X per run; 0 disables retries.
X_RETRY_LIMIT=20

# Search / Ingestion: Ingest job postings from Twitter / X (ENABLE_TWITTER=true).
# 1. Official X API v2 Bearer Token (https://developer.x.com):
X_BEARER_TOKEN=
# 2. Or Xquik API Key (https://xquik.com):
XQUIK_API_KEY=

# --- Site -----------------------------------------------------------------
# Public URL of the GitHub Pages dashboard, once deployed. Used for the RSS
# feed's self-link and the Telegram digest's "browse all" button.
SITE_URL=

# --- Misc -------------------------------------------------------------
DRY_RUN=false

# Encrypts your Telegram marks (data/feedback.enc). Create one: python -m predoc_pipeline.cli feedback-key
FEEDBACK_ENCRYPTION_KEY=
