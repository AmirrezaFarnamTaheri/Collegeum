# Copy to .env for local runs. In CI, set these as repository secrets and
# they are injected as environment variables by .github/workflows/pipeline.yml
# -- never commit a real .env file (it is gitignored).

# --- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Where new positions are posted. For a personal bot use YOUR OWN chat id
# (a positive number; run `predoc-pipeline telegram-chat-id` to find it).
# Then /positions and the ✅ ❌ 📝 buttons work. A channel (@name or
# -100...) works too, but then commands/buttons need TELEGRAM_ADMIN_CHAT_ID.
TELEGRAM_PUBLIC_CHANNEL_ID=
# Optional: where warnings go (sources failing, quiet weeks). Defaults to the
# chat above when that is your private chat.
TELEGRAM_ADMIN_CHAT_ID=

# --- Model provider (OPTIONAL) ------------------------------------------------
# Leave empty to use the rule-based extractor (no API, no quota, works
# everywhere -- Gemini is not available in some countries, e.g. Iran).
# EXTRACTION_BACKEND=auto picks Gemini only when a key is set.
GEMINI_API_KEY=
EXTRACTION_BACKEND=auto
# See ARCHITECTURE.md for current model naming; check the AI Studio console
# for your account's actual rate limits before changing the two below.
GEMINI_MODEL=gemini-flash-lite-latest
LLM_REQUESTS_PER_MINUTE=10
LLM_REQUESTS_PER_DAY=200

# --- Source toggles ---------------------------------------------------
# Feeds and portals read what publishers deliberately syndicate. Read
# COMPLIANCE.md before enabling either flag below.
ENABLE_JOBSPY=false
ENABLE_TWITTER=false
# Only consulted if ENABLE_TWITTER=true. Format, one account per line:
#   username:password:email:email_password:cookies_json_string
# Injected as a single multi-line secret in CI; never write real values here.
TWSCRAPE_ACCOUNTS=

# --- Site -----------------------------------------------------------------
# Public URL of the GitHub Pages dashboard, once deployed. Used for the RSS
# feed's self-link and the Telegram digest's "browse all" button.
SITE_URL=

# --- Misc -------------------------------------------------------------
DRY_RUN=false
