# Copy to .env for local runs. In CI, set these as repository secrets and
# they are injected as environment variables by .github/workflows/pipeline.yml
# -- never commit a real .env file (it is gitignored).

# --- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Where new positions are posted. For a personal bot use YOUR OWN chat id
# (a positive number; run `predoc-pipeline telegram-chat-id` to find it).
# Then /positions and the ✅ ❌ 📝 buttons work. A channel (@name or
# -100...) works too, but then commands/buttons need TELEGRAM_ADMIN_CHAT_ID.
TELEGRAM_PUBLIC_CHANNEL_ID=
# Optional: where warnings go (sources failing, quiet weeks). Defaults to the
# chat above when that is your private chat.
TELEGRAM_ADMIN_CHAT_ID=

# --- Model provider (OPTIONAL) ------------------------------------------------
# Leave empty to use the zero-budget rule-based extractor (no API, no quota, works
# everywhere -- Gemini is not available in some countries, e.g. Iran).
# EXTRACTION_BACKEND=auto automatically detects the first configured provider
# in order (GROQ -> NVIDIA -> OPENAI -> ANTHROPIC -> OPENROUTER -> MISTRAL -> GEMINI -> CUSTOM)
# or falls back to the heuristic extractor if no API key is provided.
EXTRACTION_BACKEND=auto

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenRouter (https://openrouter.ai/keys)
# Supports comma-separated keys for automatic key rotation on 429:
# OPENROUTER_API_KEY=sk-or-v1-key1,sk-or-v1-key2,...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Mistral AI (https://console.mistral.ai/)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Mem0 (https://app.mem0.ai) / Custom / Local (Ollama, vLLM, LMStudio)
MEMO_API_KEY=
MEMO_MODEL=
MEMO_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=default
CUSTOM_LLM_BASE_URL=http://localhost:8000/v1

# Concurrency & Rate Limits
EXTRACTION_CONCURRENCY=8
LLM_REQUESTS_PER_MINUTE=150
LLM_REQUESTS_PER_DAY=5000

# --- Source toggles ---------------------------------------------------
# Feeds and portals read what publishers deliberately syndicate. Read
# COMPLIANCE.md before enabling either flag below.
ENABLE_JOBSPY=false
ENABLE_TWITTER=false
# Only consulted if ENABLE_TWITTER=true. Format, one account per line:
#   username:password:email:email_password:cookies_json_string
# Injected as a single multi-line secret in CI; never write real values here.
TWSCRAPE_ACCOUNTS=

# --- Site -----------------------------------------------------------------
# Public URL of the GitHub Pages dashboard, once deployed. Used for the RSS
# feed's self-link and the Telegram digest's "browse all" button.
SITE_URL=

# --- Misc -------------------------------------------------------------
DRY_RUN=false
